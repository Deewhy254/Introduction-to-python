      "source": [
        "•\tWrite a single clean, commented function called clean_dataset(df) that performs ALL cleaning steps from Tier 1 (datetime conversion, fill missing Glucose with mean, fill BMI by ward group, replace categorical missing with 'Unknown', flag LOS missing). Return the cleaned DataFrame."
      ],
      "metadata": {
        "id": "fQpv14b9xb0A"
      }
    },
    {
      "cell_type": "code",
      "source": [
        "def clean_dataset(df):\n",
        "    \"\"\"\n",
        "    Perform all Tier 1 cleaning steps on the raw clinical dataset.\n",
        "    Returns a cleaned copy — does NOT modify the input DataFrame.\n",
        "    \"\"\"\n",
        "    df = df.copy()  # always copy — never mutate the raw data\n",
        "\n",
        "    # 1. Convert date column\n",
        "    df['Admission_Date'] = pd.to_datetime(df['Admission_Date'])\n",
        "\n",
        "    # 2. Fill Glucose with column mean\n",
        "    df['Glucose_mg_dL'] = df['Glucose_mg_dL'].fillna(df['Glucose_mg_dL'].mean())\n",
        "\n",
        "    # 3. Fill BMI with ward-specific group mean\n",
        "    ward_bmi = df.groupby('Ward')['BMI'].transform('mean')\n",
        "    df['BMI'] = df['BMI'].fillna(ward_bmi)\n",
        "\n",
        "    # 4. Categorical missing → 'Unknown'\n",
        "    df['Smoking_Status'] = df['Smoking_Status'].fillna('Unknown')\n",
        "    df['Blood_Type']     = df['Blood_Type'].fillna('Unknown')\n",
        "\n",
        "    # 5. Flag and drop missing LOS\n",
        "    df['LOS_Missing'] = df['LOS_Days'].isnull()\n",
        "    df = df.dropna(subset=['LOS_Days']).reset_index(drop=True)\n",
        "\n",
        "    return df\n",
        "\n",
        "# Apply to raw data\n",
        "df_raw   = pd.read_csv('clinical_patient_dataset.csv')\n",
        "df_final = clean_dataset(df_raw)\n",
        "print(df_final.shape)   # (116, 16)\n"
      ],
